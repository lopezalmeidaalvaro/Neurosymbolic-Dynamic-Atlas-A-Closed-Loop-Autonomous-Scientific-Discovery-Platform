{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QADEMotif",
  "type": "object",
  "required": [
    "motif_id",
    "version",
    "status",
    "created_date",
    "last_updated",
    "pattern_before",
    "pattern_after",
    "workload_families",
    "hardware_context",
    "validation",
    "performance",
    "transferability",
    "ip",
    "provenance"
  ],
  "properties": {
    "motif_id": {
      "type": "string",
      "pattern": "^QADE-M-\\d{4}$",
      "description": "Unique identifier in the format QADE-M-XXXX"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic versioning string"
    },
    "status": {
      "type": "string",
      "enum": ["DISCOVERED", "VALIDATED", "REUSABLE", "DEPLOYED", "DEPRECATED", "ARCHIVED"],
      "description": "Current status of the motif in its lifecycle"
    },
    "created_date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 creation timestamp"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 last update timestamp"
    },
    "pattern_before": {
      "type": "object",
      "required": ["gates", "qubit_count", "gate_count"],
      "properties": {
        "gates": {
          "type": "array",
          "items": { "type": "object" },
          "description": "Array of gates representing the original subcircuit before optimization"
        },
        "qubit_count": {
          "type": "integer",
          "minimum": 1
        },
        "gate_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pattern_after": {
      "type": "object",
      "required": ["gates", "qubit_count", "gate_count"],
      "properties": {
        "gates": {
          "type": "array",
          "items": { "type": "object" },
          "description": "Array of gates representing the optimized subcircuit after rewrite"
        },
        "qubit_count": {
          "type": "integer",
          "minimum": 0
        },
        "gate_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "workload_families": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Circuit families where this motif has been detected"
    },
    "hardware_context": {
      "type": "object",
      "required": ["backends_tested", "topology_types", "qubit_range"],
      "properties": {
        "backends_tested": {
          "type": "array",
          "items": { "type": "string" }
        },
        "topology_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "qubit_range": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["method", "fidelity_threshold", "fidelity_achieved", "validator_version", "validation_date"],
      "properties": {
        "method": { "type": "string" },
        "fidelity_threshold": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "fidelity_achieved": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "validator_version": { "type": "string" },
        "validation_date": { "type": "string", "format": "date-time" }
      }
    },
    "performance": {
      "type": "object",
      "required": [
        "gate_reduction",
        "depth_reduction",
        "fidelity_improvement",
        "application_count",
        "success_count",
        "failure_count"
      ],
      "properties": {
        "gate_reduction": { "type": "number" },
        "depth_reduction": { "type": "number" },
        "fidelity_improvement": { "type": "number" },
        "application_count": { "type": "integer", "minimum": 0 },
        "success_count": { "type": "integer", "minimum": 0 },
        "failure_count": { "type": "integer", "minimum": 0 }
      }
    },
    "transferability": {
      "type": "object",
      "required": ["score", "tested_families", "confidence"],
      "properties": {
        "score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "tested_families": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "ip": {
      "type": "object",
      "required": ["licensing_boundary", "economic_contribution", "patentability_note"],
      "properties": {
        "licensing_boundary": {
          "type": "string",
          "enum": ["PUBLIC", "PROPRIETARY", "CUSTOMER_PRIVATE"]
        },
        "economic_contribution": {
          "type": "number",
          "description": "Estimated economic contribution in USD (modelo especulativo — sin revenue real)"
        },
        "patentability_note": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["origin_phase", "benchmark_source", "discovery_algorithm"],
      "properties": {
        "origin_phase": { "type": "string" },
        "benchmark_source": { "type": "string" },
        "discovery_algorithm": { "type": "string" }
      }
    }
  }
}
